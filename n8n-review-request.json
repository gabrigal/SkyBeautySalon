{
  "name": "GO AI — Review Request Worker",
  "nodes": [
    {
      "id": "rr-0001-0000-0000-0000-000000000001",
      "name": "Schedule (every 30 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "rr-0002-0000-0000-0000-000000000002",
      "name": "Claim Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "POST",
        "url": "https://www.skybeautysalon.com/api/automation/jobs/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_AUTOMATION_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"job_type\": \"review_request\", \"limit\": 25 }",
        "options": {}
      }
    },
    {
      "id": "rr-0003-0000-0000-0000-000000000003",
      "name": "Split Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const jobs = $json.jobs || [];\nif (jobs.length === 0) return [];\nreturn jobs.map(job => ({ json: job }));"
      }
    },
    {
      "id": "rr-0004-0000-0000-0000-000000000004",
      "name": "Verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://www.skybeautysalon.com/api/automation/jobs/{{ $json.job_id }}/verify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "rr-0005-0000-0000-0000-000000000005",
      "name": "Is Sendable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sendable-check",
              "leftValue": "={{ $json.sendable }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "rr-0006-0000-0000-0000-000000000006",
      "name": "Send Review Request Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1340, 160],
      "credentials": {
        "gmailOAuth2": {
          "id": "kHdixHoKD8OAzZkJ",
          "name": "Gmail account 3"
        }
      },
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Split Jobs').item.json.customer_email }}",
        "subject": "How was your recent visit? — Sky Beauty Salon",
        "message": "=<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><style>body{font-family:Georgia,serif;background:#f9f9f9;margin:0;padding:40px 20px}.wrap{max-width:560px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 20px rgba(0,0,0,.08)}.hdr{background:#000;padding:40px;text-align:center}.logo{color:#fff;font-size:24px;letter-spacing:5px;margin:0 0 4px;font-weight:400}.tag{color:#555;font-size:10px;letter-spacing:3px;text-transform:uppercase;margin:0}.bdy{padding:40px}.greeting{font-size:18px;color:#111;margin:0 0 8px}.sub{font-size:14px;color:#666;margin:0 0 24px;line-height:1.7}.cta-wrap{text-align:center;margin:32px 0}.cta{display:inline-block;background:#000;color:#fff;text-decoration:none;padding:14px 32px;font-size:12px;letter-spacing:3px;text-transform:uppercase}.note{font-size:12px;color:#999;margin:24px 0 0;line-height:1.7}.ftr{background:#f5f5f5;padding:24px 40px;text-align:center;color:#aaa;font-size:11px;line-height:1.8}</style></head><body><div class=\"wrap\"><div class=\"hdr\"><p class=\"logo\">SKY BEAUTY</p><p class=\"tag\">Salon &amp; Studio</p></div><div class=\"bdy\"><p class=\"greeting\">Hi {{ $('Split Jobs').item.json.customer_name }},</p><p class=\"sub\">Thank you so much for your recent {{ $('Split Jobs').item.json.service }} appointment. We truly appreciate your visit and hope you loved your results.</p><p class=\"sub\">Your feedback means everything to us. If you have a moment, we would love it if you shared your experience.</p><div class=\"cta-wrap\"><a href=\"{{ $env.GOOGLE_REVIEW_URL }}\" class=\"cta\">Leave a Review</a></div><p class=\"note\">Ready to book your next appointment? We would love to see you again.</p><div class=\"cta-wrap\"><a href=\"{{ $('Split Jobs').item.json.booking_url }}\" style=\"font-size:12px;color:#000;letter-spacing:2px;text-transform:uppercase;\">Book Now →</a></div></div><div class=\"ftr\">Sky Beauty Salon &bull; New York, NY<br>To unsubscribe, reply to this email.</div></div></body></html>",
        "options": {
          "htmlBody": true
        }
      },
      "continueOnFail": true
    },
    {
      "id": "rr-0007-0000-0000-0000-000000000007",
      "name": "Mark Sent or Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 160],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "error-check",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "rr-0008-0000-0000-0000-000000000008",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "parameters": {
        "method": "POST",
        "url": "=https://www.skybeautysalon.com/api/automation/jobs/{{ $('Split Jobs').item.json.job_id }}/failed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_AUTOMATION_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"error\": \"{{ $json.error?.message || 'Gmail send failed' }}\" }",
        "options": {}
      }
    },
    {
      "id": "rr-0009-0000-0000-0000-000000000009",
      "name": "Mark Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 260],
      "parameters": {
        "method": "POST",
        "url": "=https://www.skybeautysalon.com/api/automation/jobs/{{ $('Split Jobs').item.json.job_id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "rr-0010-0000-0000-0000-000000000010",
      "name": "Mark Cancelled",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 440],
      "parameters": {
        "method": "POST",
        "url": "=https://www.skybeautysalon.com/api/automation/jobs/{{ $('Split Jobs').item.json.job_id }}/cancel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_AUTOMATION_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"reason\": \"{{ $json.reason || 'not_eligible' }}\" }",
        "options": {}
      }
    }
  ],
  "connections": {
    "Schedule (every 30 min)": {
      "main": [[{ "node": "Claim Jobs", "type": "main", "index": 0 }]]
    },
    "Claim Jobs": {
      "main": [[{ "node": "Split Jobs", "type": "main", "index": 0 }]]
    },
    "Split Jobs": {
      "main": [[{ "node": "Verify", "type": "main", "index": 0 }]]
    },
    "Verify": {
      "main": [[{ "node": "Is Sendable?", "type": "main", "index": 0 }]]
    },
    "Is Sendable?": {
      "main": [
        [{ "node": "Send Review Request Email", "type": "main", "index": 0 }],
        [{ "node": "Mark Cancelled", "type": "main", "index": 0 }]
      ]
    },
    "Send Review Request Email": {
      "main": [[{ "node": "Mark Sent or Failed", "type": "main", "index": 0 }]]
    },
    "Mark Sent or Failed": {
      "main": [
        [{ "node": "Mark Failed", "type": "main", "index": 0 }],
        [{ "node": "Mark Sent", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
