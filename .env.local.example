# ─────────────────────────────────────────────────────────────────────────────
# GO AI Salon Platform — Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local — verify .gitignore includes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: cloud.supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...   # "publishable" key (safe in browser)
SUPABASE_SECRET_KEY=eyJhbGciOi...                    # secret key — NEVER expose to browser

# ── App ───────────────────────────────────────────────────────────────────────
# Production domain (no trailing slash). Used to build management URLs in emails.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# UUID of the "Sky Beauty Salon" row in the businesses table.
# Run: SELECT id FROM businesses WHERE slug = 'sky-beauty'; after running the migration.
SALON_BUSINESS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── N8N Webhooks (server-side only — DO NOT prefix with NEXT_PUBLIC_) ─────────
# The existing booking webhook URL (unchanged from before)
N8N_BOOKING_WEBHOOK_URL=https://gabrigal.app.n8n.cloud/webhook/sky-beauty-booking

# New webhooks — create these in n8n first, then paste the URLs here
N8N_CANCEL_WEBHOOK_URL=https://gabrigal.app.n8n.cloud/webhook/sky-beauty-cancel
N8N_RESCHEDULE_WEBHOOK_URL=https://gabrigal.app.n8n.cloud/webhook/sky-beauty-reschedule
N8N_RECONCILE_WEBHOOK_URL=https://gabrigal.app.n8n.cloud/webhook/sky-beauty-reconcile
N8N_AVAILABILITY_URL=https://gabrigal.app.n8n.cloud/webhook/sky-beauty-availability

# Shared secret for n8n → /api/n8n-event callbacks
# Generate: openssl rand -hex 32
N8N_EVENT_SECRET=your-secret-here

# ── Internal ──────────────────────────────────────────────────────────────────
# Shared secret protecting /api/import/gcal-event
IMPORT_SECRET=your-import-secret-here

# Shared secret protecting /api/cron/* routes
# For Vercel Cron Jobs, use the CRON_SECRET pattern from Vercel docs
CRON_SECRET=your-cron-secret-here
